APP_NAME="Repair Tracking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- PostgreSQL (main connection) ---
# Step 1: use the owner account (e.g. postgres) so `migrate:fresh --seed` can create tables.
# Step 2: after running database/sql/roles.sql, switch these two to repair_app.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=repair_tracking
DB_USERNAME=postgres
DB_PASSWORD=

# --- Read-only role used by Reports (fill in after running roles.sql) ---
# DB_READONLY_USERNAME=repair_readonly
# DB_READONLY_PASSWORD=readonly_pass_change_me

# File-based sessions/cache so no extra tables are needed
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
